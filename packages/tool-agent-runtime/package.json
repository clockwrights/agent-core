{
  "name": "@maya-ai/tool-agent-runtime",
  "version": "0.1.1",
  "description": "Lightweight, domain-neutral runtime for tool-calling LLM agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.73.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "llm",
    "agent",
    "tool-calling",
    "ai"
  ]
}
